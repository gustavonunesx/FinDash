NEXT_PUBLIC_SUPABASE_URL=...
NEXT_PUBLIC_SUPABASE_ANON_KEY=...
SUPABASE_SERVICE_ROLE_KEY=...
STRIPE_WEBHOOK_SECRET=...
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Open Finance (Pluggy) — credenciais do dashboard em https://dashboard.pluggy.ai
# Nunca prefixar com NEXT_PUBLIC_: dao acesso total a conta Pluggy.
# A API Key nao vai aqui — expira em 2h e e gerada em runtime a partir destas duas.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# URL HTTPS publica que recebe os webhooks da Pluggy (dominio da Vercel).
# Localhost nao funciona: a Pluggy so entrega em HTTPS.
PLUGGY_WEBHOOK_URL=

RESEND_API_KEY=
RESEND_FROM=FinDash <onboarding@resend.dev>
CRON_SECRET=
